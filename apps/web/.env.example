# Origen PUBLICO de la API, con /api/v1. SSR y checkout lo usan; nunca incluir secretos.
# Modo directo: web y API deben ser same-site; en local usar 127.0.0.1 en ambas.
# Incluir el origen web exacto en CORS_ORIGINS del backend.
API_BASE_URL=http://127.0.0.1:3001/api/v1
# true: compra/consulta mediante el dominio web (Vercel sin dominio propio).
# false: conexión directa a la API (dominios propios bajo el mismo sitio).
# Cambiar requiere reconstruir/redesplegar la web; el valor público se deriva automáticamente.
CHECKOUT_PROXY_ENABLED=false
# Solo servidor: misma clave aleatoria de 64 caracteres hexadecimales en web y API.
# Obligatoria con proxy activo; nunca NEXT_PUBLIC_. No reutilizar claves de Supabase.
CHECKOUT_PROXY_SECRET=
# mock is permitted only with APP_ENV=development or test, never a production build.
API_MODE=live
APP_ENV=development
NEXT_TELEMETRY_DISABLED=1
# Límite de UI para el comprobante. Igualar RECEIPT_MAX_BYTES de la API (máximo 10 MiB).
RECEIPT_MAX_BYTES=5242880
# Obligatorio con proxy activo: origen web externo exacto, sin barra final.
WEB_ORIGIN=
# Directorio HTTPS exacto del bucket PUBLICO de premios. Vacío: mostrar placeholder.
# Nunca usar bucket de comprobantes ni URL firmada. Reiniciar Next al cambiarlo.
PUBLIC_PRIZE_IMAGE_BASE_URL=
# Solo next dev local: http://127.0.0.1:3001/api/v1/media con DEVELOPMENT_LOCAL_MEDIA=true en API.
# En staging/production se exige directorio HTTPS del bucket publico de premios.
# Auth administrativo M4: mismo proyecto que la API. Solo se leen en el servidor.
# Usar URL HTTPS y clave publicable; nunca service_role ni una clave secreta aquí.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: auto (predeterminado), 4 o 6 para Auth HTTP. Nunca NEXT_PUBLIC_.
HTTP_DNS_FAMILY=auto
# Solo desarrollo/test loopback: prueba de login sin TOTP hasta una fecha ISO UTC.
# Vacío desactiva la prueba. No habilita órdenes, comprobantes ni conciliación.
ADMIN_LOGIN_WITHOUT_TOTP_UNTIL=
