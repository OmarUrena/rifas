{
  "name": "@sorteos/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:prepare": "node -r ts-node/register src/development/prepare-workflow.ts",
    "dev": "node -r ts-node/register src/dev.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node -r ts-node/register --test --test-concurrency=1 test/foundation.test.ts test/local-tools.test.ts test/dev-runner.test.ts test/stage2.test.ts test/lookup.test.ts test/checkout-proxy.test.ts",
    "test:esm": "node --no-experimental-require-module --test test/esm-startup.test.mjs test/vercel-entrypoint.test.mjs",
    "test:integration": "node -r ts-node/register --test --test-concurrency=1 test/database.integration.ts test/schema.integration.ts test/catalog.integration.ts test/checkout.integration.ts test/orders.integration.ts test/payments.integration.ts test/resilience.integration.ts",
    "test:resilience": "node -r ts-node/register --test test/resilience.integration.ts",
    "test:payments": "node -r ts-node/register --test test/payments.integration.ts",
    "test:orders": "node -r ts-node/register --test test/orders.integration.ts",
    "test:checkout": "node -r ts-node/register --test test/checkout.integration.ts",
    "test:catalog": "node -r ts-node/register --test test/catalog.integration.ts",
    "db:migrate:local": "node -r ts-node/register src/database/migrate-local.ts",
    "db:seed:demo": "node -r ts-node/register src/database/seed-demo.ts",
    "admin:provision:local": "node -r ts-node/register src/auth/provision-local-admin.ts",
    "openapi": "node -r ts-node/register src/export-openapi.ts",
    "test:recovery": "node -r ts-node/register --test --test-concurrency=1 --test-name-pattern=\"recuperación B[34]\" test/checkout.integration.ts test/orders.integration.ts",
    "test:schema": "node -r ts-node/register --test test/schema.integration.ts",
    "test:lottery": "node -r ts-node/register --test --test-name-pattern=\"etapa 4\" test/payments.integration.ts",
    "test:lookup": "node -r ts-node/register --test --test-name-pattern=\"etapa 5\" test/payments.integration.ts",
    "test:sales": "node -r ts-node/register --test --test-name-pattern=\"etapa 6\" test/payments.integration.ts",
    "test:adjustments:edge": "node -r ts-node/register --test --test-name-pattern=\"etapa 7\" test/payments.integration.ts"
  },
  "dependencies": {
    "undici": "7.30.2",
    "@nestjs/common": "^11.1.26",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@supabase/supabase-js": "2.118.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jose": "6.2.10",
    "pdf-lib": "1.17.1",
    "pg": "^8.19.0",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.26",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.6.1",
    "ts-node": "^10.9.2"
  }
}
