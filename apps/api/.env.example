NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# El launcher web usa 127.0.0.1; mantener el mismo host para la cookie invitada.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
SWAGGER_ENABLED=true
LOG_LEVEL=info
RATE_LIMIT=120
RATE_TTL_MS=60000
# memory solo en development/test; postgres obligatorio en staging/production.
# Requiere migración M6 aplicada y CHECKOUT_ABUSE_HASH_KEY igual entre instancias.
HTTP_RATE_STORE=memory
# Opcional en desarrollo. Sin DB, ready devuelve 503 DATABASE_NOT_CONFIGURED.
DATABASE_URL=
# TLS con verificacion de certificado por defecto. Desactivar solo en PostgreSQL local.
DATABASE_SSL=true
# Certificado CA PEM opcional, con saltos de linea escapados como \n.
DATABASE_CA=
# Comandos locales exclusivamente; nunca habilitar en staging/production.
SEED_DEMO=false
# Proyecto propio con claves de firma asimétricas ES256/RS256. Sin valor: admin falla cerrado.
SUPABASE_URL=
# Clave publicable del mismo proyecto, no service_role ni sb_secret_. Solo servidor.
SUPABASE_PUBLISHABLE_KEY=
# Bucket público exclusivo de imágenes de premios, nunca el de comprobantes.
PUBLIC_RAFFLE_BUCKET=raffle-media
# Bootstrap manual local sobre DB migrada SIN seed. UUID real del usuario Supabase propio.
PROVISION_LOCAL_ADMIN=false
LOCAL_ADMIN_USER_ID=
LOCAL_ADMIN_ROLE=OWNER
# B3: TTL y límites persistentes. Clave HMAC privada y estable entre instancias.
# Obligatoria (>=32 caracteres aleatorios) en staging/production; no publicarla.
# En desarrollo/test sin clave se genera una por proceso.
CHECKOUT_ABUSE_HASH_KEY=
HOLD_TTL_MINUTES=60
HOLD_MAX_QUANTITY=100
HOLD_MAX_ACTIVE_SESSION=1
HOLD_MAX_ACTIVE_IP=3
HOLD_HOURLY_IP=20
CHECKOUT_SESSION_HOURLY_IP=60
HOLD_SWEEP_MS=30000
# B4: bucket privado exclusivo; se verifica public=false antes de cada carga.
PRIVATE_RECEIPT_BUCKET=receipts
RECEIPT_MAX_BYTES=5242880
# Solo servidor: sb_secret_... o service_role legado. Nunca NEXT_PUBLIC_.
# Sin esta clave real, órdenes nuevas fallan con STORAGE_UNAVAILABLE.
SUPABASE_STORAGE_KEY=
# Opcional: auto (predeterminado), 4 o 6 para HTTP saliente. Mantiene TLS verificado.
# Usar 4 solo en equipos donde la resolucion dual-stack provoque esperas/timeouts.
HTTP_DNS_FAMILY=auto
# Solo desarrollo/test loopback. Requiere concesion privada vigente en DB para el admin.
# Nunca publicar la capacidad ni activarla en staging/production. Vacios: MFA obligatorio.
ADMIN_DEVELOPMENT_MFA_TOKEN=
ADMIN_DEVELOPMENT_MFA_UNTIL=
# Recibos DEMO privados en .tmp/development-receipts, servidos solo por proxy autenticado.
# Solo development/test y loopback; production/staging rechazan esta opcion.
DEVELOPMENT_LOCAL_RECEIPTS=false
# Fotos propias PUBLICAS de premios en .tmp/development-media; nunca comprobantes.
# Solo desarrollo/test loopback. La API rechaza esta opcion en staging/production.
DEVELOPMENT_LOCAL_MEDIA=false
# Solo CLI; establecer en el proceso al ejecutar dev:prepare, no en produccion.
DEVELOPMENT_SETUP_ENABLED=false
